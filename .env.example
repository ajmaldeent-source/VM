# Optional: where contact enquiries are forwarded (e.g. a HubSpot/Salesforce webhook).
# Leave unset in the POC; submissions are validated and logged server-side only.
ENQUIRY_WEBHOOK_URL=

# Admin area — Google sign-in (NextAuth)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <site-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the site, e.g. https://papaya-vacherin-eb848c.netlify.app
NEXTAUTH_URL=
# Staff roles (comma-separated Google accounts). Everyone else who signs in is a consumer.
ADMIN_EMAILS=
DEVELOPER_EMAILS=
